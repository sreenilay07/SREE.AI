# SREE.AI Backend Environment Variables Example
PORT=5000

# Upstox Developer API Credentials
UPSTOX_ACCESS_TOKEN=YOUR_UPSTOX_ACCESS_TOKEN_HERE

# Groq AI Engine API Key
GROQ_API_KEY=YOUR_GROQ_API_KEY_HERE

# Upstox OAuth Parameters
UPSTOX_CLIENT_ID=YOUR_UPSTOX_CLIENT_ID_HERE
UPSTOX_CLIENT_SECRET=YOUR_UPSTOX_CLIENT_SECRET_HERE
UPSTOX_REDIRECT_URI=http://localhost:5000/api/auth/upstox/callback

# Allowed Frontend URL for CORS
FRONTEND_URL=http://localhost:5173
